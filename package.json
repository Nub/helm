{
  "name": "helm",
  "version": "1.0.0",
  "description": "Command dashboard for long-lived Claude agent projects",
  "scripts": {
    "start": "node server/main.ts",
    "dev": "node --watch server/main.ts",
    "dev:web": "vite web",
    "build": "vite build web",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p web",
    "test": "node --test server/*.test.ts web/test/*.test.ts",
    "check:sessions": "node server/checks/sessions.check.ts",
    "check:ui-skill": "node server/checks/ui-skill.check.ts",
    "check:pins": "node server/checks/pins.check.ts",
    "check:holders": "node server/checks/holders.check.ts",
    "check:split": "node server/checks/split.check.ts",
    "check:search-speed": "node server/checks/searchbench.check.ts",
    "check:hostwork": "node server/checks/hostwork.check.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.327",
    "@fastify/busboy": "^3.2.6",
    "@fastify/static": "^10.1.11",
    "fastify": "^5.12.8",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dompurify": "^3.4.18",
    "marked": "^18.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "private": true
}
